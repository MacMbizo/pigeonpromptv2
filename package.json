{
  "name": "pigeon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MacMbizo/pigeonpromptv2.git"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "preview": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:unit": "vitest --run",
    "test:e2e:ci": "playwright test --reporter=line,junit",
    "test:e2e:smoke:ci": "playwright test tests/e2e/smoke.spec.ts tests/e2e/playground-smoke.spec.ts --reporter=line,junit --output=playwright-report-smoke"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/cli": "4.8.3",
    "@playwright/test": "1.48.2",
    "@types/node": "20.12.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "9.11.1",
    "eslint-config-next": "14.2.5",
    "typescript": "5.6.2",
    "vitest": "1.6.0"
  }
}
