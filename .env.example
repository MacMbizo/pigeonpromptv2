# Example environment variables for Pigeon (do NOT put secrets here)
# Copy to .env and fill in values locally. NEXT_PUBLIC_ vars are safe to expose to the browser.

# Backend services
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=

# Local development DB
LOCAL_DATABASE_URL=
PIGEON_DB_MODE=local

# Client-side debugging flags
# 0/1 or true/false; enables verbose autosave debugging in the browser console
NEXT_PUBLIC_DEBUG_AUTOSAVE=0